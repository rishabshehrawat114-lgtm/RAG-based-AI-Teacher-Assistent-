# =============================================================================
# RAG-Based AI Teaching Assistant — Environment Configuration Template
# =============================================================================
# Copy this file to .env and customize values for your local environment:
#
#   cp .env.example .env     (macOS / Linux / Git Bash)
#   Copy-Item .env.example .env  (Windows PowerShell)
#
# WARNING: NEVER commit the actual .env file or real API keys to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application Environment & Logging
# -----------------------------------------------------------------------------
# Options: development, production, testing (default: development)
APP_ENV=development

# Logging verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL (default: INFO)
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Relevance / Abstention Gate (Module 9)
# -----------------------------------------------------------------------------
# Minimum cosine similarity threshold for retrieved context to be accepted.
# Queries scoring below this cutoff trigger graceful abstention. (default: 0.32)
RELEVANCE_THRESHOLD=0.32

# -----------------------------------------------------------------------------
# Vector Embeddings (Module 6)
# -----------------------------------------------------------------------------
# Local Sentence-Transformers model name (default: all-MiniLM-L6-v2)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32
NORMALIZE_EMBEDDINGS=True

# -----------------------------------------------------------------------------
# Whisper Speech Transcription (Module 3)
# -----------------------------------------------------------------------------
# Whisper model size: tiny, base, small, medium, large (default: base)
WHISPER_MODEL=base

# -----------------------------------------------------------------------------
# Text Chunking Settings (Module 5)
# -----------------------------------------------------------------------------
# Chunk size in words and overlap between adjacent chunks (defaults: 700 / 100)
CHUNK_SIZE=700
CHUNK_OVERLAP=100

# -----------------------------------------------------------------------------
# Retrieval Parameters (Module 7)
# -----------------------------------------------------------------------------
# Default number of passages retrieved per query (default: 5)
TOP_K=5
# Optional hard similarity threshold (leave blank for adaptive thresholding)
# SIMILARITY_THRESHOLD=

# -----------------------------------------------------------------------------
# LLM Provider & Generation (Module 9, Optional)
# -----------------------------------------------------------------------------
# If OPENAI_API_KEY is left empty, the application operates in 100% offline
# deterministic mode (direct lecture quotes & timestamp citations).
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
LLM_TEMPERATURE=0.2
MAX_CONTEXT_CHUNKS=5
CONVERSATION_TURNS=4

# -----------------------------------------------------------------------------
# Upload & File Limits
# -----------------------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=200

# -----------------------------------------------------------------------------
# Custom Directory Overrides (Optional — defaults to project data/ directories)
# -----------------------------------------------------------------------------
# DATA_DIR=
# VIDEO_DIR=
# AUDIO_DIR=
# TRANSCRIPT_DIR=
# CHUNK_DIR=
# EMBEDDING_DIR=
# PROCESSED_DATA_DIR=
# COURSE_CATALOG_PATH=
# EVALUATION_DATASET_PATH=
# RESULTS_DIR=
